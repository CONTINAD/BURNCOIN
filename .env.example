# --------------------------------------------------------------------
# $BURN — config template. Copy to .env and fill in values.
# Cycle: every CYCLE_INTERVAL_SECONDS the bot
#   1. Claims pump.fun creator fees from the DEV wallet
#   2. Spends BUYBACK_PERCENT of the claim buying back $BURN on pump.fun
#   3. Burns 100% of the tokens it just bought (decrements mint.supply)
# That's it. No wheel, no winners, no holders. Pure deflation.
# --------------------------------------------------------------------

# --- Solana RPC ---
# Use a paid RPC (Helius / QuickNode / Triton). Free RPCs throttle hard.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Wallets ---
# DEV_WALLET / CREATOR_WALLET = the wallet that owns the pump.fun $BURN token
# and receives creator fees. This same wallet does the buyback and the burn
# (single-wallet mode, default). Put the base58 private key here.
CREATOR_WALLET_PRIVATE_KEY=base58_secret_key

# Optional: if you want a separate wallet to do the buy + burn (so the dev
# wallet never holds tokens), set BUYER_WALLET_PRIVATE_KEY. Leave blank for
# single-wallet mode — recommended.
# BUYER_WALLET_PRIVATE_KEY=

# Optional: if set, MARKETING_PERCENT of every claim is forwarded here at the
# end of each cycle. If unset, marketing slice stays in the dev wallet.
# MARKETING_WALLET=

# --- Token ---
# auto = bot watches the dev wallet and adopts the next pump.fun token it
# launches. Once $BURN is live you can hardcode the mint address here.
BURN_MINT=auto
MINT_WATCH_POLL_SECONDS=20

# --- PumpPortal (https://pumpportal.fun) ---
# Lightning API key for server-side signing. Leave blank for local signing
# (works the same, just signs the tx in this process).
PUMPPORTAL_API_KEY=

# --- Cycle settings ---
CYCLE_INTERVAL_SECONDS=120            # 120 = 2 minutes
MIN_BUYBACK_SOL=0.0005                # skip buyback this cycle if slice < this

# Split of every claim — must sum to 100.
# Default: 100% buyback. Set MARKETING_PERCENT>0 (and a MARKETING_WALLET above)
# if you want to siphon some of each claim into marketing.
BUYBACK_PERCENT=100
MARKETING_PERCENT=0

BUYBACK_SLIPPAGE_PCT=20               # pump.fun slippage tolerance for buys
PRIORITY_FEE=0.0005                   # SOL priority fee per tx (escalates on retry)

# --- State persistence ---
# On Railway / any host with a persistent volume, point this at the volume
# mount path (e.g. /data). Falls back to ./data locally.
# STATE_DIR=/data

# --- Dashboard ---
PORT=3000
LOG_LEVEL=info
